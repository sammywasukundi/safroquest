PORT=8787
# Comma-separated list of allowed web origins (CORS).
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Development: the first account created becomes admin. Set DEV_ADMIN=0 (or NODE_ENV=production) to turn it off.
DEV_ADMIN=1
# Production: addresses that are admins, comma-separated.
ADMIN_ADDRESSES=
# Where the JSON store is written. Defaults to apps/api/data/db.json
# DB_FILE=
# Safrochain REST endpoint used for balances.
# CHAIN_REST=https://rest.testnet.safrochain.com
